# Copiar a .env.local. scripts/deploy-testnet.sh lo completa solo.

# Red Stellar (testnet)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Id del contrato `sello` desplegado (empieza con C)
SELLO_CONTRACT_ID=

# Clave secreta de la cuenta de la asociación (empieza con S). Solo vive en el servidor.
ASSOCIATION_SECRET=
ASSOCIATION_PUBLIC=

# Contraseña del panel de la asociación
PANEL_PASSWORD=

# URL pública de la app: se usa en el QR de las etiquetas
PUBLIC_BASE_URL=http://localhost:3000

# Carpeta donde se guardan fotos y fichas (almacenamiento local)
# HILO_DATA_DIR=.data
